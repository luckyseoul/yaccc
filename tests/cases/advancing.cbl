       IDENTIFICATION DIVISION.
       PROGRAM-ID. ADV.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT F1 ASSIGN TO "a1.txt" ORGANIZATION LINE SEQUENTIAL.
           SELECT F2 ASSIGN TO "a2.txt" ORGANIZATION LINE SEQUENTIAL.
           SELECT F3 ASSIGN TO "a3.txt" ORGANIZATION LINE SEQUENTIAL.
           SELECT F4 ASSIGN TO "a4.txt" ORGANIZATION LINE SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD F1. 01 R1 PIC X(10).
       FD F2. 01 R2 PIC X(10).
       FD F3. 01 R3 PIC X(10).
       FD F4. 01 R4 PIC X(10).
       PROCEDURE DIVISION.
           OPEN OUTPUT F1 F2 F3 F4.
           MOVE "A1" TO R1. WRITE R1 AFTER ADVANCING 1 LINE.
           MOVE "A2" TO R1. WRITE R1 AFTER ADVANCING 1 LINE.
           MOVE "A3" TO R1. WRITE R1 AFTER ADVANCING 2 LINES.
           MOVE "A5" TO R1. WRITE R1 AFTER ADVANCING 1 LINE.
           MOVE "B1" TO R2. WRITE R2 BEFORE ADVANCING 2 LINES.
           MOVE "B2" TO R2. WRITE R2 BEFORE ADVANCING 1 LINE.
           MOVE "B3" TO R2. WRITE R2.
           MOVE "B4" TO R2. WRITE R2 AFTER ADVANCING PAGE.
           MOVE "B6" TO R2. WRITE R2 AFTER ADVANCING 1.
           MOVE "C1" TO R3. WRITE R3 AFTER ADVANCING 0 LINES.
           MOVE "C2" TO R3. WRITE R3 AFTER ADVANCING 3 LINES.
           MOVE "D1" TO R4. WRITE R4.
           MOVE "D2" TO R4. WRITE R4 AFTER ADVANCING 1.
           MOVE "D3" TO R4. WRITE R4 AFTER ADVANCING 1.
           CLOSE F1 F2 F3 F4.
           STOP RUN.
