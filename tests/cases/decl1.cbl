       IDENTIFICATION DIVISION.
       PROGRAM-ID. DECL1.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SPECIAL-NAMES.
           DECIMAL-POINT IS COMMA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT IN-FILE ASSIGN TO "does-not-exist.dat"
               ORGANIZATION IS LINE SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD IN-FILE.
       01 IN-REC        PIC X(10).
       WORKING-STORAGE SECTION.
       01 AMT           PIC 9(5)V99 VALUE 1234,5.
       01 AMT-ED        PIC ZZ.ZZ9,99.
       01 RATE          PIC 9V9(4) VALUE 0,0725.
       PROCEDURE DIVISION.
       DECLARATIVES.
       IN-ERR SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON IN-FILE.
       IN-ERR-PARA.
           DISPLAY "DECLARATIVE: I/O ERROR ON IN-FILE".
       END DECLARATIVES.
       MAIN SECTION.
       MAIN-PARA.
           MOVE AMT TO AMT-ED.
           DISPLAY "EUROPEAN FORMAT: " AMT-ED.
           DISPLAY "RAW: " AMT " RATE: " RATE.
           COMPUTE AMT = AMT * (1 + RATE).
           MOVE AMT TO AMT-ED.
           DISPLAY "WITH RATE: " AMT-ED.
           OPEN INPUT IN-FILE.
           DISPLAY "CONTINUED AFTER DECLARATIVE".
           STOP RUN.
