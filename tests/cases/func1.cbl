       IDENTIFICATION DIVISION.
       PROGRAM-ID. FUNC1.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 R           PIC S9(5)V9(8).
       01 N           PIC S9(9).
       01 X           PIC X(20).
       01 S           PIC X(30) VALUE "  Hello World  ".
       01 D8          PIC 9(8).
       01 DT          PIC 9(8) VALUE 20240229.
       01 INTD        PIC 9(7).
       01 A           PIC 9(3) VALUE 7.
       01 B           PIC 9(3) VALUE 3.
       PROCEDURE DIVISION.
           MOVE FUNCTION ABS(-12.5) TO R. DISPLAY "ABS " R.
           MOVE FUNCTION INTEGER(-2.5) TO R. DISPLAY "INTEGER " R.
           MOVE FUNCTION INTEGER(2.5) TO R. DISPLAY "INTEGER+ " R.
           MOVE FUNCTION INTEGER-PART(-2.5) TO R. DISPLAY "INT-PART " R.
           MOVE FUNCTION FRACTION-PART(-2.75) TO R. DISPLAY "FRAC " R.
           MOVE FUNCTION MOD(-7, 3) TO R. DISPLAY "MOD(-7,3) " R.
           MOVE FUNCTION MOD(7, -3) TO R. DISPLAY "MOD(7,-3) " R.
           MOVE FUNCTION REM(-7, 3) TO R. DISPLAY "REM(-7,3) " R.
           MOVE FUNCTION MOD(A, B) TO R. DISPLAY "MOD(A,B) " R.
           MOVE FUNCTION SQRT(2) TO R. DISPLAY "SQRT(2) " R.
           MOVE FUNCTION SQRT(144) TO R. DISPLAY "SQRT(144) " R.
           MOVE FUNCTION PI TO R. DISPLAY "PI " R.
           MOVE FUNCTION E TO R. DISPLAY "E " R.
           MOVE FUNCTION EXP(1) TO R. DISPLAY "EXP(1) " R.
           MOVE FUNCTION LOG(10) TO R. DISPLAY "LOG(10) " R.
           MOVE FUNCTION LOG10(1000) TO R. DISPLAY "LOG10 " R.
           MOVE FUNCTION SIN(0.5) TO R. DISPLAY "SIN " R.
           MOVE FUNCTION COS(0.5) TO R. DISPLAY "COS " R.
           MOVE FUNCTION TAN(0.5) TO R. DISPLAY "TAN " R.
           MOVE FUNCTION ATAN(1) TO R. DISPLAY "ATAN " R.
           MOVE FUNCTION ASIN(0.5) TO R. DISPLAY "ASIN " R.
           MOVE FUNCTION ACOS(0.5) TO R. DISPLAY "ACOS " R.
           MOVE FUNCTION FACTORIAL(10) TO N. DISPLAY "10! " N.
           MOVE FUNCTION MAX(3, 9.5, 2) TO R. DISPLAY "MAX " R.
           MOVE FUNCTION MIN(3, -9, 2) TO R. DISPLAY "MIN " R.
           MOVE FUNCTION SUM(1, 2, 3.5) TO R. DISPLAY "SUM " R.
           MOVE FUNCTION MEAN(1, 2, 3, 4) TO R. DISPLAY "MEAN " R.
           MOVE FUNCTION MEDIAN(5, 1, 3, 2, 4) TO R.
           DISPLAY "MEDIAN " R.
           MOVE FUNCTION MEDIAN(4, 1, 3, 2) TO R. DISPLAY "MEDIAN4 " R.
           MOVE FUNCTION RANGE(5, 1, 9) TO R. DISPLAY "RANGE " R.
           MOVE FUNCTION MIDRANGE(5, 1, 9) TO R. DISPLAY "MIDRANGE " R.
           MOVE FUNCTION VARIANCE(2, 4, 4, 4, 5, 5, 7, 9) TO R.
           DISPLAY "VARIANCE " R.
           MOVE FUNCTION STANDARD-DEVIATION(2, 4, 4, 4, 5, 5, 7, 9)
             TO R.
           DISPLAY "STDDEV " R.
           MOVE FUNCTION ORD-MAX(3, 9, 2) TO N. DISPLAY "ORD-MAX " N.
           MOVE FUNCTION ORD-MIN(3, 9, 2) TO N. DISPLAY "ORD-MIN " N.
           MOVE FUNCTION SIGN(-5) TO N. DISPLAY "SIGN " N.
           MOVE FUNCTION LENGTH(S) TO N. DISPLAY "LENGTH " N.
           MOVE FUNCTION LENGTH("ABC") TO N. DISPLAY "LENGTH LIT " N.
           MOVE FUNCTION UPPER-CASE(S) TO X. DISPLAY "[" X "]".
           MOVE FUNCTION LOWER-CASE(S) TO X. DISPLAY "[" X "]".
           MOVE FUNCTION REVERSE("ABCDE") TO X. DISPLAY "[" X "]".
           MOVE FUNCTION TRIM(S) TO X. DISPLAY "[" X "]".
           MOVE FUNCTION TRIM(S LEADING) TO X. DISPLAY "[" X "]".
           MOVE FUNCTION TRIM(S TRAILING) TO X. DISPLAY "[" X "]".
           DISPLAY "[" FUNCTION TRIM(S) "]".
           MOVE FUNCTION LENGTH(FUNCTION TRIM(S)) TO N.
           DISPLAY "TRIMMED LENGTH " N.
           MOVE FUNCTION CHAR(66) TO X. DISPLAY "CHAR(66) [" X "]".
           MOVE FUNCTION ORD("A") TO N. DISPLAY "ORD(A) " N.
           MOVE FUNCTION NUMVAL(" -12.50 ") TO R. DISPLAY "NUMVAL " R.
           MOVE FUNCTION NUMVAL("12.50-") TO R. DISPLAY "NUMVAL T " R.
           MOVE FUNCTION NUMVAL("  42  ") TO R. DISPLAY "NUMVAL I " R.
           MOVE FUNCTION NUMVAL-C("$1,234.56") TO R.
           DISPLAY "NUMVAL-C " R.
           MOVE FUNCTION INTEGER-OF-DATE(20240229) TO INTD.
           DISPLAY "INT-OF-DATE " INTD.
           MOVE FUNCTION DATE-OF-INTEGER(INTD) TO D8.
           DISPLAY "DATE-OF-INT " D8.
           COMPUTE INTD = FUNCTION INTEGER-OF-DATE(20241231)
                        - FUNCTION INTEGER-OF-DATE(20240101).
           DISPLAY "DAYS IN 2024 - 1: " INTD.
           MOVE FUNCTION DATE-OF-INTEGER(1) TO D8.
           DISPLAY "DAY 1 = " D8.
           MOVE FUNCTION INTEGER-OF-DAY(2024060) TO INTD.
           DISPLAY "INT-OF-DAY " INTD.
           MOVE FUNCTION DAY-OF-INTEGER(INTD) TO INTD.
           DISPLAY "DAY-OF-INT " INTD.
           MOVE FUNCTION ANNUITY(0.01, 12) TO R. DISPLAY "ANNUITY " R.
           MOVE FUNCTION PRESENT-VALUE(0.1, 100, 100) TO R.
           DISPLAY "PV " R.
           COMPUTE R = FUNCTION SQRT(16) + FUNCTION ABS(-4) * 2.
           DISPLAY "EXPR " R.
           MOVE FUNCTION CONCATENATE("AB" "CD" "EF") TO X.
           DISPLAY "CONCAT [" X "]".
           MOVE FUNCTION UPPER-CASE("mixed Case") (1:5) TO X.
           DISPLAY "REFMOD FN [" X "]".
           MOVE FUNCTION MAX("APPLE" "PEAR" "BANANA") TO X.
           DISPLAY "MAX ALPHA [" X "]".
           MOVE FUNCTION YEAR-TO-YYYY(24, 50, 2000) TO N.
           DISPLAY "YEAR-TO-YYYY " N.
           MOVE FUNCTION TEST-DATE-YYYYMMDD(20230229) TO N.
           DISPLAY "TEST-DATE " N.
           STOP RUN.
