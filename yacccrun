#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""yacccrun - run a program from a module that yaccc -m built, as cobcrun
does for cobc's modules."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), 'lib'))

from yaccc.driver import run_module  # noqa: E402

if __name__ == '__main__':
    sys.exit(run_module(sys.argv[1:]))
